# Laragon MySQL default: user root, empty password
DATABASE_URL="mysql://root:@localhost:3306/cleaningos"
PORT=4000
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN="http://localhost:5173"
# Use a long random string (min 32 chars) in production
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="8h"
# Used once by `npm run db:seed` to create the first admin
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@cleaningos.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# Set to "false" in production so the seed does not create demo staff
SEED_DEMO_STAFF="true"

# ---- Production (VPS) values, for reference ----
# NODE_ENV="production"
# HOST="127.0.0.1"
# PORT=4000
# CLIENT_ORIGIN="https://planbfacilitymanagement.com,https://www.planbfacilitymanagement.com"
